{
    "name": "ogrenci/ev-otel-rezervasyon",
    "description": "Otel / Kiralık Ev Rezervasyon Sistemi - PHP 8.2, katmanlı mimari, frameworksüz (Aşama 2: veriler JSON dosyalarında)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "ext-openssl": "Gerçek e-posta (SMTP, TLS) için (config/yerel.php: mail_driver = smtp)"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public public/index.php"
        ],
        "seed": "php bin/seed.php --force",
        "gorev": "php bin/gorev.php",
        "yedek": "php bin/yedek.php",
        "eposta:dene": "php bin/eposta-dene.php",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit"
        ],
        "test:hizli": "phpunit --exclude-group eszamanlilik",
        "kapsam": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-text --only-summary-for-coverage-text --coverage-html coverage"
        ],
        "izlenebilirlik": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --log-junit storage/logs/test-sonuc.xml --coverage-clover storage/logs/kapsam.xml",
            "php bin/izlenebilirlik.php --sonuc=storage/logs/test-sonuc.xml --kapsam=storage/logs/kapsam.xml"
        ],
        "analiz": "phpstan analyse --memory-limit=1G",
        "stil": "phpcs",
        "stil:duzelt": "phpcbf"
    },
    "config": {
        "sort-packages": true
    }
}
